          feedback.textContent =
            "Die gespeicherten Punktwerte konnten " +
            "nicht vollständig geprüft werden.";
          return;
        }

        const total = states.reduce(
          (sum, state) => sum + state.points,
          0
        );

        const criticalTasks = states.flatMap(
          (state, index) =>
            state.critical === true ? [index + 1] : []
        );

        const criticalCount = criticalTasks.length;

        totalElement.textContent = String(total);
        completedElement.textContent = String(completedCount);
        criticalElement.textContent = String(criticalCount);

        scoreFill.style.width = total + "%";

        if (criticalCount > 0) {
