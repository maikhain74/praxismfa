    <script>
      const startButton = document.getElementById("start-case");
      const intro = document.getElementById("case-intro");
      const simulation = document.getElementById("simulation");

      startButton?.addEventListener("click", () => {
        if (!intro || !simulation) return;

        intro.hidden = true;
        simulation.hidden = false;
        simulation.scrollIntoView({ behavior: "smooth", block: "start" });
      });

      const task1Form = document.getElementById("task-1-form");
      const task1Message = document.getElementById("task-1-message");
      const task1Complete = document.getElementById("task-1-complete");
      const task1Score = document.getElementById("task-1-score");

      const storageKey = "praxismfa-schwindel-fall01-task1-v1";

      let task1State = {
        firstAnswer: null,
        points: 0,
        critical: false,
        completed: false,
        wrongAttempts: 0
      };

      try {
        const saved = localStorage.getItem(storageKey);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (
            parsed &&
            typeof parsed === "object" &&
            ["A", "B", "C", "D"].includes(parsed.firstAnswer) &&
            typeof parsed.points === "number" &&
            typeof parsed.critical === "boolean" &&
            typeof parsed.completed === "boolean"
          ) {
            task1State = parsed;
            task1State.wrongAttempts =
              Number.isInteger(parsed.wrongAttempts) &&
              parsed.wrongAttempts >= 0
                ? parsed.wrongAttempts
                : 0;
          }
        }
      } catch {
        // Die Aufgabe bleibt auch ohne lokalen Speicher nutzbar.
      }

      function saveTask1() {
        try {
          localStorage.setItem(storageKey, JSON.stringify(task1State));
        } catch {
          // Keine Unterbrechung bei deaktiviertem Browserspeicher.
        }
      }

      function finishTask1() {
        if (!task1State.completed) return;

        if (task1Form) task1Form.hidden = true;
        if (task1Complete) task1Complete.hidden = false;
        if (task1Score) {
          task1Score.textContent = String(task1State.points);
        }
      }

      if (task1State.completed) {
        finishTask1();
      } else if (task1State.firstAnswer !== null && task1Message) {
        task1Message.textContent =
          "Deine erste Antwort wurde bereits bewertet. " +
          "Wähle jetzt die sichere Vorgehensweise, um fortzufahren.";
      }

      task1Form?.addEventListener("submit", (event) => {
        event.preventDefault();

        const formData = new FormData(task1Form);
        const answer = formData.get("task-1");

        if (typeof answer !== "string" ||
            !["A", "B", "C", "D"].includes(answer)) {
          if (task1Message) {
            task1Message.textContent =
              "Bitte wähle zuerst eine Antwort aus.";
          }
          return;
        }

        if (task1State.firstAnswer === null) {
          task1State.firstAnswer = answer;
          task1State.points = answer === "B" ? 6 : 0;
          task1State.critical = ["C", "D"].includes(answer);
          saveTask1();
        }

        if (answer === "B") {
          task1State.completed = true;
          saveTask1();
          finishTask1();
        
        } else {
          task1State.wrongAttempts += 1;
          saveTask1();

          if (task1Message) {
            const basicHint =
              "Diese Entscheidung ist nicht ausreichend sicher. " +
              "Denke zuerst an die unmittelbare Sturzgefahr, " +
              "die Unterstützung durch das Praxisteam und " +
              "die unverzügliche Beurteilung des Zustands. " +
              "Überprüfe deine Entscheidung.";

            const additionalHint =
              " Zusätzlicher Hinweis: Überlege, welche " +
              "Maßnahmen die Patientin unmittelbar schützen " +
              "und wie du gleichzeitig eine schnelle " +
              "medizinische Einschätzung organisierst.";

            task1Message.textContent =
              basicHint +
              (task1State.wrongAttempts >= 2
                ? additionalHint
                : "");
          }
        }
      });
    
      const task1Next = document.getElementById("task-1-next");
      const task2Panel = document.getElementById("task-2-panel");
