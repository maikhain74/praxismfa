        const phases = [
          { start: 1, end: 3, title: "Phase 1 · Ersteinschätzung" },
          { start: 4, end: 6, title: "Phase 2 · Dynamische Notfallsituation" },
          { start: 7, end: 9, title: "Phase 3 · Dokumentation und Übergabe" },
          { start: 10, end: 12, title: "Phase 4 · Akute Zustandsverschlechterung" },
          { start: 13, end: 13, title: "Phase 5 · Rettungsdienst und Übergabe" },
          { start: 14, end: 14, title: "Phase 6 · Dokumentation" },
          { start: 15, end: 15, title: "Phase 7 · Abschluss und Patientensicherheit" }
        ];

        const phase = phases.find(
          item => taskNumber >= item.start && taskNumber <= item.end
        );

        const phaseLabel = simulation?.querySelector(
          ":scope > .eyebrow"
        );

        if (phase && phaseLabel) {
          phaseLabel.textContent = phase.title;
        }
      }

      function restoreCaseNavigation() {
        const states = [
          task1State,
          task2State,
          task3State,
          task4State,
          task5State,
          task6State,
          task7State,
          task8State,
          task9State,
          task10State,
          task11State,
          task12State,
          task13State,
          task14State,
          task15State
        ];

        const hasProgress = states.some(
          state =>
            state.completed === true ||
            state.firstAnswer !== null
        );

        if (!hasProgress) return;

        const firstIncomplete = states.findIndex(
          state => state.completed !== true
        );

        const currentTask =
          firstIncomplete === -1 ? 15 : firstIncomplete + 1;

        const panels = [
          document.querySelector(
            "#simulation > .placeholder"
          ),
          ...Array.from(
            { length: 14 },
            (_, index) =>
              document.getElementById(
                "task-" + (index + 2) + "-panel"
              )
          )
        ];

        if (panels.some(panel => !panel)) return;
        if (!intro || !simulation) return;

        panels.forEach((panel, index) => {
          panel.hidden = index !== currentTask - 1;
        });

        intro.hidden = true;
        simulation.hidden = false;

        updateCasePhase(currentTask);

        if (progressLabel) {
          progressLabel.textContent =
            firstIncomplete === -1
              ? "Praxisfall abgeschlossen"
              : "Aufgabe " + currentTask + " von 15";
        }

        if (progressFill) {
          progressFill.style.width =
            ((currentTask / 15) * 100).toFixed(2) + "%";
        }

        if (firstIncomplete === -1) {
          renderFinalResult();
        }

        const currentPanel = panels[currentTask - 1];

        currentPanel.scrollIntoView({
          behavior: "auto",
          block: "start"
        });
      }

      restoreCaseNavigation();

</script>
  </body>
</html>
