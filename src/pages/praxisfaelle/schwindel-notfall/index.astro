      function renderFinalResult() {
        const states = [
          task1State,
          task2State,
          task3State,
          task4State,
          task5State,
          task6State,
          task7State,
          task8State,
          task9State,
          task10State,
          task11State,
          task12State,
          task13State,
          task14State,
          task15State
        ];

        const completedCount = states.filter(
          state => state.completed === true
        ).length;

        if (completedCount !== 15) return;

        const result = document.getElementById("final-result");
        const totalElement =
          document.getElementById("final-total-score");
        const completedElement =
          document.getElementById("final-completed-count");
        const criticalElement =
          document.getElementById("final-critical-count");
        const scoreFill =
          document.getElementById("final-score-fill");
        const feedback =
          document.getElementById("final-feedback");

        if (
          !result ||
          !totalElement ||
          !completedElement ||
          !criticalElement ||
          !scoreFill ||
          !feedback
        ) return;

        const maximumPoints = [
          6, 6, 8, 10, 10,
          10, 6, 5, 4, 6,
          9, 5, 7, 5, 3
        ];

        const validScores = states.every(
          (state, index) =>
            Number.isFinite(state.points) &&
            state.points >= 0 &&
            state.points <= maximumPoints[index] &&
            (
              index === 6
                ? Number.isInteger(state.points * 2)
                : Number.isInteger(state.points)
            )
        );

