      const attemptHistoryKey =
        "praxismfa-schwindel-history-v1";

      const attemptRecordedKey =
        "praxismfa-schwindel-attempt-recorded-v1";

      function readAttemptHistory() {
        try {
          const parsed = JSON.parse(
            localStorage.getItem(attemptHistoryKey) || "[]"
          );

          if (!Array.isArray(parsed)) return [];

          return parsed.filter(entry =>
            entry &&
            typeof entry.date === "string" &&
            Number.isFinite(entry.points) &&
            entry.points >= 0 &&
            entry.points <= 100 &&
            Number.isInteger(entry.critical) &&
            entry.critical >= 0 &&
            entry.critical <= 15
          ).slice(-5);
        } catch {
          return [];
        }
      }

      function saveCompletedAttempt(points, critical) {
        try {
          if (localStorage.getItem(attemptRecordedKey) === "1") {
            return;
          }

          const history = readAttemptHistory();

          history.push({
            date: new Date().toISOString(),
            points,
            critical
          });

          localStorage.setItem(
            attemptHistoryKey,
            JSON.stringify(history.slice(-5))
          );

          localStorage.setItem(attemptRecordedKey, "1");
        } catch {
          // Der Praxisfall bleibt auch ohne Browserspeicher nutzbar.
        }
      }

      function renderAttemptHistory() {
        const list = document.getElementById(
          "attempt-history-list"
        );

        if (!list) return;

        list.replaceChildren();

        const history = readAttemptHistory();

        if (history.length === 0) {
          const item = document.createElement("li");
          item.textContent =
            "Noch keine gespeicherten Ergebnisse vorhanden.";
          list.appendChild(item);
          return;
        }

        [...history].reverse().forEach((entry, index) => {
          const item = document.createElement("li");
          const date = new Date(entry.date);

          const dateText = Number.isNaN(date.getTime())
            ? "Datum unbekannt"
            : date.toLocaleString("de-DE");

          item.textContent =
            dateText + ": " +
            entry.points + " von 100 Punkten, " +
            (entry.critical === 0
              ? "keine Aufgabe mit sicherheitskritischen Fehlern."
              : entry.critical === 1
                ? "1 Aufgabe mit sicherheitskritischen Fehlern."
                : entry.critical +
                  " Aufgaben mit sicherheitskritischen Fehlern.");

          list.appendChild(item);
        });
      }

