---
import PraxisfallEngine from "../../../components/praxisfaelle/PraxisfallEngine.astro";
import { musterfall } from "../../../lib/praxisfaelle/musterfall.js";

const title = "Technischer Musterfall";
const description = "Testseite für die wiederverwendbare PraxisMFA-Engine.";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | PraxisMFA</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/">PraxisMFA</a>

      <nav aria-label="Hauptnavigation">
        <a href="/lernen/">Lernen</a>
        <a href="/praxis/">Praxis</a>
        <a href="/pruefung/">Prüfung</a>
        <a href="/lernkarten/">Lernkarten</a>
        <a class="premium" href="/premium/">Premium</a>
      </nav>
    </header>

    <main>
      <a class="back-link" href="/praxisfaelle/">
        ← Zurück zu den Praxisfällen
      </a>

      <PraxisfallEngine fall={musterfall} />
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    font-family: Inter, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #fffaf5;
    color: #222;
  }

  :global(body) {
    margin: 0;
  }

  .site-header {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
    min-height: 110px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .brand {
    color: #222;
    text-decoration: none;
    font-size: 1.45rem;
    font-weight: 800;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 38px;
  }

  nav a {
    color: #333;
    text-decoration: none;
    font-weight: 650;
  }

  nav a:hover {
    color: #e67e22;
  }

  .premium {
    padding: 11px 20px;
    border: 1px solid #e67e22;
    border-radius: 999px;
    background: #e67e22;
    color: #fff;
  }

  main {
    width: min(900px, calc(100% - 40px));
    margin: 0 auto;
    padding-bottom: 120px;
  }

  .back-link {
    display: inline-block;
    margin: 48px 0 36px;
    color: #555;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .site-header {
      width: calc(100% - 32px);
      min-height: 90px;
      flex-direction: column;
      justify-content: center;
      gap: 18px;
      padding: 20px 0;
    }

    nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
    }

    main {
      width: calc(100% - 32px);
    }
  }
</style>
