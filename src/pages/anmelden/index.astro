---
const title = "Anmelden | PraxisMFA";
const description = "Melde dich bei PraxisMFA an und verwalte deinen Lernzugang.";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Hauptnavigation">
        <a class="logo" href="/" aria-label="PraxisMFA Startseite">
          <img src="/images/praxismfa-logo-header.png" alt="PraxisMFA" />
        </a>

        <div class="nav-links">
          <a href="/lernen/">Lernen</a>
          <a href="/praxis/">Praxis</a>
          <a href="/pruefung/">Prüfung</a>
          <a href="/lernkarten/">Lernkarten</a>
          <a class="premium-link" href="/premium/">Premium</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="login-section">
        <div class="login-card">
          <p class="eyebrow">Dein PraxisMFA-Konto</p>
          <h1>Willkommen zurück!</h1>
          <p class="intro">
            Melde dich an, um deinen Lernzugang zu verwalten.
          </p>

          <form id="login-form">
            <label for="email">E-Mail-Adresse</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="deine@email.de"
            />

            <label for="password">Passwort</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              placeholder="Dein Passwort"
            />

            <button id="login-button" type="submit">
              Anmelden
            </button>

            <p id="login-message" class="message" role="status" aria-live="polite"></p>
          </form>

          <p class="register-link">
            <a href="#" id="forgot-password-link">
              Passwort vergessen?
            </a>
          </p>

          <p
            id="recovery-message"
            class="message"
            role="status"
            aria-live="polite"
          ></p>

          <p class="register-link">
            Noch kein Konto?
            <a href="/registrieren/">Jetzt registrieren</a>
          </p>
        </div>
      </section>
    </main>

    <script>
      import { supabase } from "../../lib/supabase/client.js";

      const form = document.querySelector("#login-form");
      const message = document.querySelector("#login-message");
      const button = document.querySelector("#login-button");

      const forgotPasswordLink = document.querySelector(
        "#forgot-password-link"
      );

      const recoveryMessage = document.querySelector(
        "#recovery-message"
      );

      forgotPasswordLink?.addEventListener("click", async (event) => {
        event.preventDefault();

        if (!(recoveryMessage instanceof HTMLElement)) return;
        if (!(forgotPasswordLink instanceof HTMLAnchorElement)) return;

        const emailInput = document.querySelector("#email");

        if (!(emailInput instanceof HTMLInputElement)) return;

        const email = emailInput.value.trim();

        if (!email || !emailInput.checkValidity()) {
          recoveryMessage.textContent =
            "Bitte gib zuerst deine gültige E-Mail-Adresse ein.";
          emailInput.focus();
          return;
        }

        recoveryMessage.textContent =
          "Der Link zur Passwortzurücksetzung wird angefordert ...";

        forgotPasswordLink.style.pointerEvents = "none";

        try {
          const { error } = await supabase.auth.resetPasswordForEmail(
            email,
            {
              redirectTo:
                window.location.origin + "/passwort-zuruecksetzen/",
            }
          );

          if (error) {
            recoveryMessage.textContent =
              "Die Anfrage konnte nicht verarbeitet werden. Bitte versuche es später erneut.";
            return;
          }

          recoveryMessage.textContent =
            "Falls ein Konto mit dieser E-Mail-Adresse existiert, erhältst du eine E-Mail zur Passwortzurücksetzung.";
        } catch {
          recoveryMessage.textContent =
            "Die Anfrage ist derzeit nicht möglich. Bitte versuche es später erneut.";
        } finally {
          forgotPasswordLink.style.pointerEvents = "";
        }
      });

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!(form instanceof HTMLFormElement)) return;
        if (!(message instanceof HTMLElement)) return;
        if (!(button instanceof HTMLButtonElement)) return;

        const formData = new FormData(form);
        const email = String(formData.get("email") || "").trim();
        const password = String(formData.get("password") || "");

        button.disabled = true;
        button.textContent = "Anmeldung läuft ...";
        message.textContent = "";

        try {
          const { error } = await supabase.auth.signInWithPassword({
            email,
            password,
          });

          if (error) {
            message.textContent =
              "Anmeldung fehlgeschlagen. Bitte überprüfe deine Zugangsdaten und die E-Mail-Bestätigung.";
            return;
          }

          window.location.assign("/");
        } catch {
          message.textContent =
            "Die Anmeldung ist derzeit nicht möglich. Bitte versuche es später erneut.";
        } finally {
          button.disabled = false;
          button.textContent = "Anmelden";
        }
      });
    
      // Passwort anzeigen oder verbergen
      document.querySelectorAll('input[type="password"]').forEach((input) => {
        if (!(input instanceof HTMLInputElement)) return;

        const button = document.createElement("button");
        button.type = "button";
        button.textContent = "Passwort anzeigen";
        button.setAttribute("aria-label", "Passwort anzeigen");
        button.setAttribute("aria-pressed", "false");

        button.style.background = "transparent";
        button.style.color = "#d56d15";
        button.style.border = "none";
        button.style.padding = "0";
        button.style.margin = "-12px 0 20px";
        button.style.textAlign = "right";
        button.style.fontSize = "0.9rem";
        button.style.cursor = "pointer";
        button.style.alignSelf = "flex-end";

        button.addEventListener("click", () => {
          const sichtbar = input.type === "password";

          input.type = sichtbar ? "text" : "password";
          button.textContent = sichtbar
            ? "Passwort verbergen"
            : "Passwort anzeigen";
          button.setAttribute(
            "aria-label",
            sichtbar ? "Passwort verbergen" : "Passwort anzeigen"
          );
          button.setAttribute("aria-pressed", String(sichtbar));
        });

        input.insertAdjacentElement("afterend", button);
      });

    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #fffaf5;
    color: #332b26;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }

  .site-header {
    background: #fff;
    border-bottom: 1px solid #f0e4d8;
  }

  .nav {
    max-width: 1180px;
    margin: 0 auto;
    padding: 18px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .logo img {
    display: block;
    max-width: 190px;
    width: 100%;
    height: auto;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }

  .nav-links a {
    color: #49382c;
    text-decoration: none;
    font-weight: 600;
  }

  .nav-links a:hover {
    color: #e67e22;
  }

  .nav-links .premium-link {
    background: #e67e22;
    color: white;
    border-radius: 999px;
    padding: 9px 20px;
  }

  .login-section {
    min-height: 75vh;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 90px 20px;
  }

  .login-card {
    width: 100%;
    max-width: 490px;
    background: #fff;
    border: 1px solid #f1e3d4;
    border-radius: 22px;
    padding: 42px;
    box-shadow: 0 16px 45px rgba(85, 56, 31, 0.07);
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #d56d15;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 12px;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    line-height: 1.2;
  }

  .intro {
    margin: 0 0 30px;
    color: #6f6258;
  }

  form {
    display: flex;
    flex-direction: column;
  }

  label {
    margin: 0 0 7px;
    font-weight: 700;
  }

  input {
    width: 100%;
    border: 1px solid #d9c9b9;
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 22px;
    font: inherit;
    background: #fffdfb;
  }

  input:focus {
    outline: 2px solid #e67e22;
    outline-offset: 2px;
  }

  button {
    background: #e67e22;
    border: none;
    border-radius: 10px;
    padding: 15px;
    color: white;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  button:hover {
    background: #cf6d18;
  }

  button:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .message {
    min-height: 24px;
    margin: 14px 0 0;
    color: #a32920;
    font-size: 0.9rem;
  }

  .register-link {
    margin: 20px 0 0;
    text-align: center;
    color: #6f6258;
  }

  .register-link a {
    color: #d56d15;
    font-weight: 700;
  }

  @media (max-width: 650px) {
    .nav {
      flex-direction: column;
    }

    .nav-links {
      justify-content: center;
      gap: 14px;
      font-size: 0.9rem;
    }

    .login-section {
      padding: 45px 16px;
    }

    .login-card {
      padding: 28px 22px;
    }
  }
</style>
