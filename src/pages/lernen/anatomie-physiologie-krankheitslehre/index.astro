---
const title = "Anatomie, Physiologie & Krankheitslehre";
const description =
  "Lerne Anatomie, Physiologie und wichtige Krankheitsbilder für deine MFA-Ausbildung verständlich und praxisnah.";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | PraxisMFA</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/">PraxisMFA</a>

      <nav aria-label="Hauptnavigation">
        <a href="/lernen">Lernen</a>
        <a href="/praxis">Praxis</a>
        <a href="/pruefung">Prüfung</a>
        <a href="/lernkarten">Lernkarten</a>
        <a class="premium" href="/premium">Premium</a>
      </nav>
    </header>

    <main>
      <a class="back-link" href="/lernen/">
        ← Zurück zu allen Fachwelten
      </a>

      <section class="hero">
        <p class="eyebrow">Fachwelt 03</p>

        <h1>Anatomie, Physiologie & Krankheitslehre</h1>

        <p class="intro">
          Verstehe, wie der menschliche Körper aufgebaut ist, wie seine
          Organsysteme funktionieren und warum typische Erkrankungen bestimmte
          Beschwerden verursachen.
        </p>

        <div class="principle">
          <strong>Unser Lernprinzip:</strong>
          <span>
            Aufbau verstehen → Funktion verstehen → Erkrankung einordnen →
            Bedeutung für die MFA-Praxis erkennen.
          </span>
        </div>
      </section>

      <section class="topics">
        <div class="section-heading">
          <p class="eyebrow">Lernbereiche</p>
          <h2>Womit möchtest du starten?</h2>
        </div>

        <div class="grid">
          <a
  class="card card-link"
  href="/lernen/anatomie-physiologie-krankheitslehre/grundlagen-menschlicher-koerper/"
>
  <span>01</span>

  <div>
    <h3>Grundlagen des menschlichen Körpers</h3>

    <p>
      Zellen, Gewebe, Organe, Organsysteme sowie wichtige medizinische
      Lage- und Richtungsbezeichnungen.
    </p>
  </div>
</a>

          <a
  class="card card-link"
  href="/lernen/anatomie-physiologie-krankheitslehre/bewegungsapparat/"
>
  <span>02</span>

  <div>
    <h3>Bewegungsapparat</h3>

    <p>
      Knochen, Gelenke, Muskeln und Wirbelsäule sowie typische
      Erkrankungen und Verletzungen.
    </p>
  </div>
</a>

          <a
            class="card card-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/herz-kreislauf/"
          >
            <span>03</span>

            <div>
              <h3>Herz & Kreislauf</h3>

              <p>
                Herzaufbau, Blutkreislauf, Blutdruck und wichtige Erkrankungen
                des Herz-Kreislauf-Systems.
              </p>
            </div>
          </a>

          <a
  class="card card-link"
  href="/lernen/anatomie-physiologie-krankheitslehre/atmungssystem/"
>
  <span>04</span>

  <div>
    <h3>Atmungssystem</h3>

    <p>
      Atemwege, Lunge, Gasaustausch sowie typische Erkrankungen und
      wichtige Warnzeichen.
    </p>
  </div>
</a>

          <article class="card">
            <span>05</span>

            <div>
              <h3>Verdauungssystem</h3>

              <p>
                Verdauungsorgane, ihre Aufgaben und häufige Erkrankungen von
                Speiseröhre, Magen, Darm, Leber und Bauchspeicheldrüse.
              </p>
            </div>
          </article>

          <article class="card">
            <span>06</span>

            <div>
              <h3>Niere & Harnwege</h3>

              <p>
                Nierenfunktion, Harnbildung, ableitende Harnwege und typische
                Erkrankungen des Harnsystems.
              </p>
            </div>
          </article>

          <article class="card">
            <span>07</span>

            <div>
              <h3>Nervensystem & Sinnesorgane</h3>

              <p>
                Gehirn, Rückenmark, Nerven und Sinnesorgane sowie wichtige
                neurologische Erkrankungen und Warnzeichen.
              </p>
            </div>
          </article>

          <article class="card">
            <span>08</span>

            <div>
              <h3>Hormonsystem & Stoffwechsel</h3>

              <p>
                Hormondrüsen, Regelkreise, Schilddrüse, Insulin,
                Glukosestoffwechsel und Diabetes mellitus.
              </p>
            </div>
          </article>

          <article class="card">
            <span>09</span>

            <div>
              <h3>Blut & Immunsystem</h3>

              <p>
                Blutbestandteile, Blutbildung, Gerinnung, Immunabwehr,
                Entzündungsreaktionen und grundlegende Erkrankungen.
              </p>
            </div>
          </article>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #fffaf5;
    color: #222;
  }

  :global(body) {
    margin: 0;
  }

  .site-header {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
    min-height: 110px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .brand {
    color: #222;
    text-decoration: none;
    font-size: 1.45rem;
    font-weight: 800;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 38px;
  }

  nav a {
    color: #333;
    text-decoration: none;
    font-weight: 650;
  }

  nav a:hover {
    color: #000;
  }

  .premium {
    padding: 11px 20px;
    border: 1px solid #d8d2cc;
    border-radius: 999px;
    background: #fff;
  }

  main {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding-bottom: 100px;
  }

  .back-link {
    display: inline-block;
    margin-top: 48px;
    color: #555;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: #111;
  }

  .hero {
    max-width: 900px;
    padding: 70px 0 100px;
  }

  .eyebrow {
    margin: 0 0 16px;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.3rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .intro {
    max-width: 760px;
    margin: 30px 0 0;
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .principle {
    max-width: 760px;
    margin-top: 34px;
    padding: 22px 24px;
    border: 1px solid #ded8d2;
    border-radius: 18px;
    background: #fff;
    line-height: 1.6;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .topics {
    padding-top: 20px;
  }

  .section-heading {
    margin-bottom: 42px;
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.03em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .card {
    min-height: 270px;
    padding: 30px;
    border: 1px solid #ded8d2;
    border-radius: 22px;
    background: #fff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-link {
    color: #222;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .card-link:hover {
    transform: translateY(-4px);
    border-color: #c9c1ba;
    box-shadow: 0 12px 30px rgba(34, 34, 34, 0.07);
  }

  .card span {
    font-size: 0.85rem;
    font-weight: 800;
    color: #777;
  }

  .card h3 {
    margin: 38px 0 14px;
    font-size: 1.4rem;
    line-height: 1.25;
  }

  .card p {
    margin: 0;
    line-height: 1.65;
    color: #555;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 850px) {
    .site-header {
      min-height: 80px;
    }

    nav {
      display: none;
    }

    .hero {
      padding: 60px 0 70px;
    }
  }

  @media (max-width: 650px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .card {
      min-height: 230px;
    }
  }
</style>