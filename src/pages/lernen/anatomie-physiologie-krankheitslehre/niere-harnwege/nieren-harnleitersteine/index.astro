const title = "Nieren- und Harnleitersteine";

const description =
  "Verstehe, wie Nieren- und Harnleitersteine entstehen, warum sie eine Nierenkolik oder einen Harnstau verursachen können und welche Warnzeichen für MFA wichtig sind.";
---

<!doctype html>

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
