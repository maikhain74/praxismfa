---
const title = "Wie die Niere den Urin bildet";

const description =
  "Verstehe die Urinbildung in der Niere mit Filtration, Primärharn, Rückresorption und Sekretion verständlich für deine MFA-Ausbildung.";
---

<!doctype html>

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
