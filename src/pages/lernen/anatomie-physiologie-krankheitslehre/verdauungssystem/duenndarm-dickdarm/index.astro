---
const title = "Dünndarm und Dickdarm";

const description =
  "Verstehe den Aufbau von Dünndarm und Dickdarm und lerne, wie Nährstoffe, Wasser und Elektrolyte aufgenommen und unverdauliche Nahrungsreste weiterverarbeitet werden.";
---

<!doctype html>

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
