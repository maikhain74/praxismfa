---
const title = "Mund, Speiseröhre und Magen";

const description =
  "Verstehe, wie die Verdauung in der Mundhöhle beginnt, wie Nahrung geschluckt und durch die Speiseröhre transportiert wird und welche Aufgaben der Magen übernimmt.";
---

<!doctype html>

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
