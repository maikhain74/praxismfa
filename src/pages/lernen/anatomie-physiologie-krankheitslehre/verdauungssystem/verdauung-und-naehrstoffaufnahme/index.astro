---
const title = "Verdauung und Nährstoffaufnahme";

const description =
  "Verstehe, wie Kohlenhydrate, Proteine und Fette verdaut, im Dünndarm aufgenommen und über Blut und Lymphe im Körper weitertransportiert werden.";
---

<!doctype html>

<html lang="de">
