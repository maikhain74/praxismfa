const title = "Wirbelsäule verstehen";

const description =
  "Verstehe den Aufbau der Wirbelsäule, ihre Abschnitte, den grundlegenden Aufbau eines Wirbels, die Bandscheiben und die physiologischen Krümmungen.";
---

<!doctype html>

<html lang="de">
