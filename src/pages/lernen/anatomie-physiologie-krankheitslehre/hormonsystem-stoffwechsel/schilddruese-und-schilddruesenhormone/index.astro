const title = "Schilddrüse und Schilddrüsenhormone";

const description =
  "Lerne Aufbau und Funktion der Schilddrüse sowie die Bedeutung der Schilddrüsenhormone T3 und T4 verständlich für deine MFA-Ausbildung kennen.";
---

