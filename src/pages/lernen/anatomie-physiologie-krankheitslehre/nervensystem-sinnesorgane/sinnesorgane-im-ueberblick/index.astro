const title = "Sinnesorgane im Überblick";
const description =
  "Lerne, wie Sinnesorgane Reize aufnehmen, in nervöse Signale umwandeln und an das zentrale Nervensystem weiterleiten – verständlich für deine MFA-Ausbildung.";
---

