const title = "Auge und Sehen";
const description =
  "Lerne Aufbau und Funktion des Auges, den Weg des Lichts zur Netzhaut und die Weiterleitung der Sehinformationen – verständlich für deine MFA-Ausbildung.";
---

<!doctype html>
<html lang="de">
  <head>
