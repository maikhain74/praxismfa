---
const title = "Nervensystem & Sinnesorgane";

const description =
  "Lerne Nervensystem und Sinnesorgane für deine MFA-Ausbildung verständlich, praxisnah und Schritt für Schritt.";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | PraxisMFA</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/">PraxisMFA</a>

      <nav aria-label="Hauptnavigation">
        <a href="/lernen">Lernen</a>
        <a href="/praxis">Praxis</a>
        <a href="/pruefung">Prüfung</a>
        <a href="/lernkarten">Lernkarten</a>
        <a class="premium" href="/premium">Premium</a>
      </nav>
    </header>

    <main>
      <a
        class="back-link"
        href="/lernen/anatomie-physiologie-krankheitslehre/"
      >
        ← Zurück zu Anatomie, Physiologie & Krankheitslehre
      </a>

      <section class="hero">
        <p class="eyebrow">Lernbereich 07</p>
        <h1>Nervensystem & Sinnesorgane</h1>

        <p class="intro">
          Verstehe Aufbau und Funktion des Nervensystems und der Sinnesorgane,
          erkenne wichtige neurologische Symptome und Notfallsituationen und
          lerne, wie du neurologische Diagnostik in der Arztpraxis vorbereitest
          und begleitest.
        </p>

        <div class="principle">
          <strong>Dein Lernweg:&nbsp;</strong>
          <span>
            Nervensystem verstehen → Sinnesorgane kennenlernen → neurologische
            Symptome einordnen → Notfälle erkennen → Diagnostik begleiten →
            Wissen in der MFA-Praxis anwenden.
          </span>
        </div>
      </section>

      <section class="learning-path">
        <div class="section-heading">
          <p class="eyebrow">Dein Lernpfad</p>
          <h2>Schritt für Schritt zum Verständnis</h2>

          <p class="section-intro">
            Beginne mit Aufbau und Funktion des Nervensystems. Danach lernst du
            die Sinnesorgane und wichtige neurologische Symptome kennen, bevor
            du Notfallsituationen, kognitive Veränderungen, neurologische
            Diagnostik und typische Praxissituationen bearbeitest.
          </p>
        </div>

        <div class="path">
          <a
            class="lesson lesson-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/nervensystem-sinnesorgane/nervensystem-im-ueberblick/"
          >
            <span class="number">01</span>
            <div class="lesson-content">
              <p class="category">Grundlage</p>
              <h3>Nervensystem im Überblick</h3>
              <p>
                Lerne die grundlegende Gliederung des Nervensystems kennen und
                verstehe das Zusammenspiel von zentralem, peripherem und
                vegetativem Nervensystem.
              </p>
            </div>
          </a>

          <a
            class="lesson lesson-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/nervensystem-sinnesorgane/gehirn-rueckenmark/"
          >
            <span class="number">02</span>
            <div class="lesson-content">
              <p class="category">Anatomie</p>
              <h3>Gehirn und Rückenmark verstehen</h3>
              <p>
                Lerne wichtige Bereiche des Gehirns und das Rückenmark kennen
                und verstehe ihre grundlegenden Aufgaben.
              </p>
            </div>
          </a>

          <a
            class="lesson lesson-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/nervensystem-sinnesorgane/nerven-reizleitung/"
          >
            <span class="number">03</span>
            <div class="lesson-content">
              <p class="category">Physiologie</p>
              <h3>Nerven und Reizleitung</h3>
              <p>
                Verstehe den Aufbau von Nervenzellen und wie Informationen als
                elektrische und chemische Signale weitergeleitet werden.
              </p>
            </div>
          </a>

          <a
            class="lesson lesson-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/nervensystem-sinnesorgane/sinnesorgane-im-ueberblick/"
          >
            <span class="number">04</span>
            <div class="lesson-content">
              <p class="category">Grundlage</p>
              <h3>Sinnesorgane im Überblick</h3>
              <p>
                Lerne, wie Sinnesreize aufgenommen, in elektrische Signale
                umgewandelt und im Nervensystem verarbeitet werden.
              </p>
            </div>
          </a>

          <a
            class="lesson lesson-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/nervensystem-sinnesorgane/auge-sehen/"
          >
            <span class="number">05</span>
            <div class="lesson-content">
              <p class="category">Anatomie & Physiologie</p>
              <h3>Auge und Sehen</h3>
              <p>
                Verstehe den Aufbau des Auges, den Weg des Lichts und wie aus
                Lichtreizen schließlich ein Seheindruck entsteht.
              </p>
            </div>
          </a>

          <a
            class="lesson lesson-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/nervensystem-sinnesorgane/ohr-hoeren-gleichgewicht/"
          >
            <span class="number">06</span>
            <div class="lesson-content">
              <p class="category">Anatomie & Physiologie</p>
              <h3>Ohr, Hören und Gleichgewicht</h3>
              <p>
                Lerne Außen-, Mittel- und Innenohr kennen und verstehe die
                Grundlagen von Hören und Gleichgewicht.
              </p>
            </div>
          </a>

          <a
            class="lesson lesson-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/nervensystem-sinnesorgane/neurologische-symptome/"
          >
            <span class="number">07</span>
            <div class="lesson-content">
              <p class="category">Symptome & Praxis</p>
              <h3>Neurologische Symptome erkennen</h3>
              <p>
                Ordne Kopfschmerzen, Schwindel, Sensibilitätsstörungen und
                Bewegungsstörungen ein und erkenne wichtige Warnzeichen.
              </p>
            </div>
          </a>

          <a
            class="lesson lesson-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/nervensystem-sinnesorgane/schlaganfall/"
          >
            <span class="number">08</span>
            <div class="lesson-content">
              <p class="category">Notfall</p>
              <h3>Schlaganfall erkennen und richtig handeln</h3>
              <p>
                Erkenne typische Schlaganfallzeichen, wende das FAST-Schema an
                und verstehe, warum bei einem Schlaganfall jede Minute zählt.
              </p>
            </div>
          </a>

          <a
            class="lesson lesson-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/nervensystem-sinnesorgane/krampfanfaelle-epilepsie/"
          >
            <span class="number">09</span>
            <div class="lesson-content">
              <p class="category">Krankheitslehre & Notfall</p>
              <h3>Krampfanfälle und Epilepsie</h3>
              <p>
                Verstehe unterschiedliche Erscheinungsformen von Krampfanfällen
                und lerne, wie du im Praxisalltag richtig reagierst.
              </p>
            </div>
          </a>

          <a
            class="lesson lesson-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/nervensystem-sinnesorgane/demenz-kognitive-veraenderungen/"
          >
            <span class="number">10</span>
            <div class="lesson-content">
              <p class="category">Krankheitslehre & Praxis</p>
              <h3>Demenz und kognitive Veränderungen</h3>
              <p>
                Lerne kognitive Veränderungen einzuordnen, akute Verwirrtheit
                von schleichendem Abbau zu unterscheiden und diagnostische
                Kurztests zu verstehen.
              </p>
            </div>
          </a>

          <a
            class="lesson lesson-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/nervensystem-sinnesorgane/neurologische-diagnostik/"
          >
            <span class="number">11</span>
            <div class="lesson-content">
              <p class="category">Diagnostik & Praxis</p>
              <h3>Neurologische Diagnostik in der Arztpraxis</h3>
              <p>
                Lerne wichtige neurologische Untersuchungen kennen und
                verstehe die Aufgaben der MFA bei Vorbereitung, Assistenz,
                Beobachtung und Dokumentation.
              </p>
            </div>
          </a>

          <a
            class="lesson lesson-link"
            href="/lernen/anatomie-physiologie-krankheitslehre/nervensystem-sinnesorgane/praxissituationen-mfa/"
          >
            <span class="number">12</span>
            <div class="lesson-content">
              <p class="category">Praxis</p>
              <h3>Praxissituationen für MFA</h3>
              <p>
                Wende dein Wissen über Nervensystem, Sinnesorgane,
                neurologische Symptome, Notfälle und Diagnostik auf typische
                Situationen aus dem Praxisalltag an.
              </p>
            </div>
          </a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #fffaf5;
    color: #222;
  }

  :global(body) {
    margin: 0;
  }

  .site-header {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
    min-height: 110px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .brand {
    color: #222;
    text-decoration: none;
    font-size: 1.45rem;
    font-weight: 800;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 38px;
  }

  nav a {
    color: #333;
    text-decoration: none;
    font-weight: 650;
  }

  nav a:hover {
    color: #000;
  }

  .premium {
    padding: 11px 20px;
    border: 1px solid #d8d2cc;
    border-radius: 999px;
    background: #fff;
  }

  main {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding-bottom: 110px;
  }

  .back-link {
    display: inline-block;
    margin-top: 48px;
    color: #555;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: #111;
  }

  .hero {
    max-width: 900px;
    padding: 70px 0 110px;
  }

  .eyebrow {
    margin: 0 0 16px;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .intro {
    max-width: 760px;
    margin: 30px 0 0;
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .principle {
    max-width: 800px;
    margin-top: 34px;
    padding: 22px 24px;
    border: 1px solid #ded8d2;
    border-radius: 18px;
    background: #fff;
    line-height: 1.6;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .learning-path {
    max-width: 900px;
  }

  .section-heading {
    margin-bottom: 44px;
  }

  h2 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .section-intro {
    max-width: 700px;
    margin: 22px 0 0;
    color: #555;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .path {
    display: flex;
    flex-direction: column;
  }

  .lesson {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 26px;
    padding: 34px 0;
    border-top: 1px solid #ded8d2;
  }

  .lesson:last-child {
    border-bottom: 1px solid #ded8d2;
  }

  .lesson-link {
    color: #222;
    text-decoration: none;
    transition:
      padding 0.2s ease,
      background 0.2s ease;
  }

  .lesson-link:hover {
    padding-left: 18px;
    padding-right: 18px;
    background: #fff;
  }

  .lesson-link:hover h3 {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .number {
    padding-top: 4px;
    color: #777;
    font-size: 0.85rem;
    font-weight: 800;
  }

  .category {
    margin: 0 0 8px;
    color: #777;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .lesson h3 {
    margin: 0;
    font-size: 1.55rem;
    line-height: 1.25;
  }

  .lesson-content > p:last-child {
    max-width: 680px;
    margin: 12px 0 0;
    color: #555;
    font-size: 1rem;
    line-height: 1.65;
  }

  @media (max-width: 850px) {
    .site-header {
      min-height: 80px;
    }

    nav {
      display: none;
    }

    .hero {
      padding: 60px 0 80px;
    }
  }

  @media (max-width: 600px) {
    .lesson {
      grid-template-columns: 44px 1fr;
      gap: 14px;
      padding: 28px 0;
    }

    .lesson h3 {
      font-size: 1.3rem;
    }
  }
</style>