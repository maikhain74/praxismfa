---
const title = "Der erste Kontakt mit Patienten";

const description =
  "Lerne, wie du Patienten beim ersten Kontakt professionell empfängst, Sicherheit gibst und durch dein Auftreten eine gute Grundlage für die weitere Kommunikation schaffst.";
---

<!doctype html>

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
