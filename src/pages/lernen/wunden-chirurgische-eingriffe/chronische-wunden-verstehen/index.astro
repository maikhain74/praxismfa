    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #ded8d2;
    border-radius: 24px;
  }

  .lesson-graphic figcaption {
    margin-top: 12px;
    color: #666;
    font-size: 0.9rem;
    line-height: 1.6;
    text-align: center;
  }

  .practice-section,
  .summary,
  .self-check {
    margin-top: 70px;
    padding: 48px;
    border-radius: 24px;
  }

  .practice-section {
    background: #fff4e9;
  }

  .case {
    margin-top: 30px;
    padding-top: 28px;
    border-top: 1px solid #d4ccc4;
  }

  .case p:not(.case-label) {
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .summary,
  .self-check {
    border: 1px solid #ded8d2;
    background: #fff;
  }

  .summary ul {
    margin: 30px 0 0;
    padding-left: 24px;
  }

  .summary li {
    margin: 14px 0;
    line-height: 1.65;
  }

  details {
    border-top: 1px solid #ded8d2;
  }

  details:last-child {
    border-bottom: 1px solid #ded8d2;
  }

  summary {
    padding: 22px 0;
    cursor: pointer;
    font-weight: 750;
    line-height: 1.5;
  }

  details p {
    margin: -4px 0 24px;
    color: #555;
    line-height: 1.7;
  }

  .next-lesson {
    margin-top: 90px;
    padding-top: 50px;
    border-top: 1px solid #ded8d2;
  }

  .next-lesson h2 {
    margin-bottom: 18px;
  }

  .next-lesson > p:last-child {
    max-width: 700px;
    color: #555;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  @media (max-width: 850px) {
    .site-header {
      min-height: 80px;
    }

    nav {
      display: none;
    }

    .lesson-hero {
      padding: 60px 0 55px;
