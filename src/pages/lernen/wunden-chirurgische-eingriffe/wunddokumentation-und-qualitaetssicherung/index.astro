<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #fffaf5;
    color: #222;
  }

  :global(body) {
    margin: 0;
  }

  .site-header {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
    min-height: 110px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .brand {
    color: #222;
    text-decoration: none;
    font-size: 1.45rem;
    font-weight: 800;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 38px;
  }

  nav a {
    color: #333;
    text-decoration: none;
    font-weight: 650;
  }

  nav a:hover {
    color: #e67e22;
  }

  .premium {
    padding: 11px 20px;
    border: 1px solid #e67e22;
    border-radius: 999px;
    background: #e67e22;
    color: #fff;
  }

  main {
    width: min(900px, calc(100% - 40px));
    margin: 0 auto;
    padding-bottom: 120px;
  }

  .back-link {
    display: inline-block;
    margin-top: 48px;
    color: #555;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: #e67e22;
  }

  .lesson-hero {
    padding: 70px 0;
  }

  .eyebrow,
  .section-number {
    margin: 0 0 16px;
    color: #e67e22;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(4rem, 10vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .lead {
    max-width: 760px;
    margin: 34px 0 0;
    font-size: 1.25rem;
    line-height: 1.75;
  }

  .goal {
    margin-top: 38px;
    padding: 24px 26px;
    border: 1px solid #ded8d2;
    border-radius: 18px;
    background: #fff4e9;
  }

  .goal-label,
  .box-label,
  .case-label {
    margin: 0 0 8px;
    color: #e67e22;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .goal p:last-child,
  .remember p:last-child,
  .connection p:last-child {
    margin: 0;
    line-height: 1.65;
  }

  .content-section {
    padding: 70px 0;
    border-top: 1px solid #ded8d2;
  }

  h2 {
    margin: 0 0 28px;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .content-section > p:not(.section-number),
  .practice-section > p:not(.eyebrow) {
    max-width: 760px;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .remember,
  .connection {
    margin-top: 32px;
    padding: 24px 26px;
    border-radius: 18px;
    background: #fff4e9;
  }

  .remember {
    border: 1px solid #eadbcf;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 36px;
  }

  .info-card {
    padding: 26px;
    border: 1px solid #ded8d2;
    border-radius: 18px;
    background: #fff;
  }

  .info-card span {
    color: #e67e22;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .info-card h3 {
    margin: 22px 0 10px;
    font-size: 1.3rem;
  }

  .info-card p {
    margin: 0;
    color: #555;
    line-height: 1.65;
  }

  .structure-list {
    margin-top: 34px;
    border-top: 1px solid #ded8d2;
  }

  .structure-list > div {
    padding: 26px 0;
    border-bottom: 1px solid #ded8d2;
  }

  .structure-list span {
    display: block;
    margin-bottom: 8px;
    color: #e67e22;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .structure-list p {
    max-width: 760px;
    margin: 0;
    color: #555;
    line-height: 1.65;
  }

  .lesson-graphic {
    margin: 48px auto 0;
    max-width: 760px;
  }

  .lesson-graphic img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #ded8d2;
    border-radius: 24px;
  }

  .lesson-graphic figcaption {
    margin-top: 12px;
    color: #666;
    font-size: 0.9rem;
    line-height: 1.6;
    text-align: center;
  }

  .practice-section,
  .summary,
  .self-check {
    margin-top: 70px;
    padding: 48px;
    border-radius: 24px;
  }

  .practice-section {
    background: #fff4e9;
  }

  .case {
    margin-top: 30px;
    padding-top: 28px;
    border-top: 1px solid #d4ccc4;
  }

  .case p:not(.case-label) {
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .summary,
  .self-check {
    border: 1px solid #ded8d2;
    background: #fff;
  }

  .summary ul {
    margin: 30px 0 0;
    padding-left: 24px;
  }

  .summary li {
    margin: 14px 0;
    line-height: 1.65;
  }

  details {
    border-top: 1px solid #ded8d2;
  }

  details:last-child {
    border-bottom: 1px solid #ded8d2;
  }

  summary {
    padding: 22px 0;
    cursor: pointer;
    font-weight: 750;
    line-height: 1.5;
  }

  details p {
    margin: -4px 0 24px;
    color: #555;
    line-height: 1.7;
  }

  .next-lesson {
    margin-top: 90px;
    padding-top: 50px;
    border-top: 1px solid #ded8d2;
  }

  .next-lesson h2 {
    margin-bottom: 18px;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.25;
  }

  .next-lesson > p:last-child {
    max-width: 700px;
    color: #555;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  @media (max-width: 850px) {
    .site-header {
      min-height: 80px;
    }

    nav {
      display: none;
    }

    .lesson-hero {
      padding: 60px 0 55px;
    }
  }

  @media (max-width: 650px) {
    .info-grid {
      grid-template-columns: 1fr;
    }

    .practice-section,
    .summary,
    .self-check {
      padding: 30px 22px;
    }
  }
