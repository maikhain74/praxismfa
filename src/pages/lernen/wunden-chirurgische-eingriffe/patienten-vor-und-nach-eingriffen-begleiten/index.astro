  summary {
    padding: 22px 0;
    cursor: pointer;
    font-weight: 750;
    line-height: 1.5;
  }

  details p {
    margin: -4px 0 24px;
    color: #555;
    line-height: 1.7;
  }

  .next-lesson {
    margin-top: 90px;
    padding-top: 50px;
    border-top: 1px solid #ded8d2;
  }

