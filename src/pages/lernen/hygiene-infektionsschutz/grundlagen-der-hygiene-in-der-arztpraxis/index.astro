---
const title = "Grundlagen der Hygiene in der Arztpraxis";

const description =
  "Lerne, warum Hygiene in der Arztpraxis unverzichtbar ist, welche Infektionsrisiken im Praxisalltag bestehen und welche Verantwortung MFA bei der Praxishygiene übernehmen.";
---

<!doctype html>

<html lang="de">
