---
const title = "Vitalzeichen & Diagnostik";
const description =
  "Lerne Vitalzeichen sicher zu erfassen, Messwerte zu beurteilen und diagnostische Untersuchungen in der Arztpraxis fachgerecht vorzubereiten.";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | PraxisMFA</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/">PraxisMFA</a>

      <nav aria-label="Hauptnavigation">
        <a href="/lernen">Lernen</a>
        <a href="/praxis">Praxis</a>
        <a href="/pruefung">Prüfung</a>
        <a href="/lernkarten">Lernkarten</a>
        <a class="premium" href="/premium">Premium</a>
      </nav>
    </header>

    <main>
      <a class="back-link" href="/lernen/">
        ← Zurück zu allen Fachwelten
      </a>

      <section class="hero">
        <p class="eyebrow">Fachwelt 04</p>

        <h1>Vitalzeichen & Diagnostik</h1>

        <p class="intro">
          Lerne, Vitalzeichen korrekt zu erfassen, Messwerte auf Plausibilität
          zu prüfen und wichtige diagnostische Untersuchungen in der
          Arztpraxis sicher vorzubereiten und durchzuführen.
        </p>

        <div class="principle">
          <strong>Unser Lernprinzip:</strong>
          <span>
            korrekt messen → Messbedingungen beachten → Auffälligkeiten
            erkennen → dokumentieren und sicher weitergeben.
          </span>
        </div>
      </section>

      <section class="topics">
        <div class="section-heading">
          <p class="eyebrow">12 Lektionen</p>
          <h2>Womit möchtest du starten?</h2>
        </div>

        <div class="grid">
          <a class="card card-link" href="/lernen/vitalzeichen-diagnostik/vitalzeichen-im-ueberblick/">
            <span>01</span>
            <div>
              <h3>Vitalzeichen im Überblick</h3>
              <p>
                Verstehe, welche Vitalzeichen in der Arztpraxis wichtig sind
                und was sie über den Zustand eines Menschen aussagen.
              </p>
            </div>
          </a>

          <a class="card card-link" href="/lernen/vitalzeichen-diagnostik/puls-richtig-messen-und-beurteilen/">
            <span>02</span>
            <div>
              <h3>Puls richtig messen und beurteilen</h3>
              <p>
                Puls sicher erfassen, Pulsfrequenz und Pulsqualität beobachten
                und auffällige Werte erkennen.
              </p>
            </div>
          </a>

          <a class="card card-link" href="/lernen/vitalzeichen-diagnostik/blutdruck-richtig-messen/">
            <span>03</span>
            <div>
              <h3>Blutdruck richtig messen</h3>
              <p>
                Blutdruckmessungen korrekt vorbereiten und durchführen sowie
                wichtige Bedingungen für zuverlässige Messwerte beachten.
              </p>
            </div>
          </a>

          <a class="card card-link" href="/lernen/vitalzeichen-diagnostik/blutdruckwerte-verstehen-und-messfehler-vermeiden/">
            <span>04</span>
            <div>
              <h3>Blutdruckwerte verstehen und Messfehler vermeiden</h3>
              <p>
                Blutdruckwerte einordnen, typische Fehlerquellen erkennen und
                auffällige Messergebnisse auf Plausibilität prüfen.
              </p>
            </div>
          </a>

          <a class="card card-link" href="/lernen/vitalzeichen-diagnostik/koerpertemperatur-messen-und-beurteilen/">
            <span>05</span>
            <div>
              <h3>Körpertemperatur messen und beurteilen</h3>
              <p>
                Messmethoden unterscheiden, Körpertemperatur korrekt erfassen
                und Veränderungen richtig beobachten.
              </p>
            </div>
          </a>

          <a class="card card-link" href="/lernen/vitalzeichen-diagnostik/atmung-beobachten-und-atemfrequenz-bestimmen/">
            <span>06</span>
            <div>
              <h3>Atmung beobachten und Atemfrequenz bestimmen</h3>
              <p>
                Atemfrequenz, Atemrhythmus und Atemtiefe beobachten und
                auffällige Veränderungen erkennen.
              </p>
            </div>
          </a>

          <a class="card card-link" href="/lernen/vitalzeichen-diagnostik/sauerstoffsaettigung-richtig-messen/">
            <span>07</span>
            <div>
              <h3>Sauerstoffsättigung richtig messen</h3>
              <p>
                Pulsoxymetrie sicher durchführen, Signalqualität beachten und
                Messergebnisse auf Plausibilität prüfen.
              </p>
            </div>
          </a>

          <a class="card card-link" href="/lernen/vitalzeichen-diagnostik/koerpergroesse-gewicht-und-bmi-bestimmen/">
            <span>08</span>
            <div>
              <h3>Körpergröße, Gewicht und BMI bestimmen</h3>
              <p>
                Körpermaße standardisiert erfassen, den BMI berechnen und die
                Grenzen seiner Aussagekraft verstehen.
              </p>
            </div>
          </a>

          <a class="card card-link" href="/lernen/vitalzeichen-diagnostik/ekg-in-der-arztpraxis-vorbereiten-und-schreiben/">
            <span>09</span>
            <div>
              <h3>EKG in der Arztpraxis vorbereiten und schreiben</h3>
              <p>
                Ein 12-Kanal-EKG vorbereiten, Elektroden korrekt anlegen und
                typische Ursachen für Artefakte vermeiden.
              </p>
            </div>
          </a>

          <a class="card card-link" href="/lernen/vitalzeichen-diagnostik/lungenfunktionspruefung-in-der-arztpraxis/">
            <span>10</span>
            <div>
              <h3>Lungenfunktionsprüfung in der Arztpraxis</h3>
              <p>
                Spirometrie vorbereiten, das Atemmanöver verständlich anleiten
                und auf die Qualität der Durchführung achten.
              </p>
            </div>
          </a>

          <a class="card card-link" href="/lernen/vitalzeichen-diagnostik/messwerte-dokumentieren-und-auffaelligkeiten-weitergeben/">
            <span>11</span>
            <div>
              <h3>Messwerte dokumentieren und Auffälligkeiten weitergeben</h3>
              <p>
                Messergebnisse vollständig dokumentieren, Auffälligkeiten
                erkennen und relevante Informationen strukturiert weitergeben.
              </p>
            </div>
          </a>

          <a class="card card-link" href="/lernen/vitalzeichen-diagnostik/praxissituationen-vitalzeichen-diagnostik/">
            <span>12 · Premium</span>
            <div>
              <h3>Praxissituationen für MFA: Vitalzeichen & Diagnostik</h3>
              <p>
                Typische Praxissituationen beurteilen, Messfehler erkennen und
                sicheres Handeln Schritt für Schritt trainieren.
              </p>
            </div>
          </a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #fffaf5;
    color: #222;
  }

  :global(body) {
    margin: 0;
  }

  .site-header {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
    min-height: 110px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .brand {
    color: #222;
    text-decoration: none;
    font-size: 1.45rem;
    font-weight: 800;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 38px;
  }

  nav a {
    color: #333;
    text-decoration: none;
    font-weight: 650;
  }

  nav a:hover {
    color: #000;
  }

  .premium {
    padding: 11px 20px;
    border: 1px solid #d8d2cc;
    border-radius: 999px;
    background: #fff;
  }

  main {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding-bottom: 100px;
  }

  .back-link {
    display: inline-block;
    margin-top: 48px;
    color: #555;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: #111;
  }

  .hero {
    max-width: 900px;
    padding: 70px 0 100px;
  }

  .eyebrow {
    margin: 0 0 16px;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.3rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .intro {
    max-width: 760px;
    margin: 30px 0 0;
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .principle {
    max-width: 760px;
    margin-top: 34px;
    padding: 22px 24px;
    border: 1px solid #ded8d2;
    border-radius: 18px;
    background: #fff;
    line-height: 1.6;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .topics {
    padding-top: 20px;
  }

  .section-heading {
    margin-bottom: 42px;
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.03em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .card {
    min-height: 270px;
    padding: 30px;
    border: 1px solid #ded8d2;
    border-radius: 22px;
    background: #fff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-link {
    color: #222;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .card-link:hover {
    transform: translateY(-4px);
    border-color: #c9c1ba;
    box-shadow: 0 12px 30px rgba(34, 34, 34, 0.07);
  }

  .card span {
    font-size: 0.85rem;
    font-weight: 800;
    color: #777;
  }

  .card h3 {
    margin: 38px 0 14px;
    font-size: 1.4rem;
    line-height: 1.25;
  }

  .card p {
    margin: 0;
    line-height: 1.65;
    color: #555;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 850px) {
    .site-header {
      min-height: 80px;
    }

    nav {
      display: none;
    }

    .hero {
      padding: 60px 0 70px;
    }
  }

  @media (max-width: 650px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .card {
      min-height: 230px;
    }
  }
</style>
