---
const title = "PraxisMFA";
const description =
  "PraxisMFA ist die Lernplattform für Medizinische Fachangestellte. Verstehen. Anwenden. Prüfung bestehen.";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | Lernplattform für Medizinische Fachangestellte</title>
  </head>

  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Hauptnavigation">
        <a class="logo" href="/">PraxisMFA</a>

        <div class="nav-links">
          <a href="/lernen/">Lernen</a>
          <a href="/praxis/">Praxis</a>
          <a href="/pruefung/">Prüfung</a>
          <a href="/lernkarten/">Lernkarten</a>
          <a class="premium-link" href="/premium/">Premium</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">
          Die Lernplattform für Medizinische Fachangestellte
        </p>

        <h1>PraxisMFA</h1>

        <p class="claim">
          Verstehen. Anwenden. Prüfung bestehen.
        </p>

        <p class="intro">
          Lerne nicht nur Antworten auswendig. Verstehe, was du in der Praxis
          erkennst, wie du richtig handelst und warum.
        </p>

        <div class="status">
          PraxisMFA entsteht gerade.
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #fffaf5;
    color: #222;
  }

  :global(body) {
    margin: 0;
  }

  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 24px 32px;
  }

  .nav {
    width: min(1180px, 100%);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .logo {
    color: #222;
    font-size: 1.3rem;
    font-weight: 800;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links a {
    color: #444;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: #111;
  }

  .nav-links .premium-link {
    padding: 9px 16px;
    border: 1px solid #d8d2cc;
    border-radius: 999px;
    background: #fff;
    color: #222;
  }

  main {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 20px 32px;
  }

  .hero {
    width: min(760px, 100%);
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 16px;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 10vw, 6rem);
    line-height: 1;
  }

  .claim {
    margin: 24px 0 0;
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    font-weight: 700;
  }

  .intro {
    max-width: 620px;
    margin: 24px auto 0;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .status {
    display: inline-block;
    margin-top: 36px;
    padding: 12px 18px;
    border: 1px solid #ddd;
    border-radius: 999px;
    font-weight: 600;
    background: #fff;
  }

  @media (max-width: 760px) {
    .site-header {
      position: static;
      padding: 20px;
    }

    .nav {
      flex-direction: column;
      gap: 18px;
    }

    .nav-links {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px 20px;
    }

    main {
      min-height: auto;
      padding: 80px 20px;
    }
  }
</style>